.vscode/
.vs/
*.sln
*.suo
*.user
*.opendb
*.db

# --- Asset Specific Ignores ---
# Ignore Autolab and asset-specific local cache
FileOpenOrder/

# --- Ignore local logs and crashes ---
*.log
*.crash